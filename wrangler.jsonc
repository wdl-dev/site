{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "src/index.js",
  "compatibility_date": "2026-05-31",

  // Static files are uploaded to the asset store at deploy time. The worker
  // resolves CSS/favicon/OG URLs via env.ASSETS.url(); CSS loads the watermark
  // relatively. env.ASSETS.url() exists only on WDL — under local `wrangler dev`
  // it is undefined and the worker throws. Verify by deploying.
  "assets": {
    "directory": "./public"
  },

  // Custom host routing for this namespace is operator-enabled (declared in the
  // platform Terraform: site_host = wdl.dev). Claim the apex so this worker
  // serves wdl.dev directly, not just <ns>.<platform-domain>.
  "routes": [
    "wdl.dev/*"
  ],

  // Serve only on wdl.dev: with a route pattern set, this makes the gateway 404
  // the <ns>.<platform-domain> URL, so there is no duplicate host to consolidate.
  "workers_dev": false
}
